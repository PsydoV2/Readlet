{
  "expo": {
    "name": "Readlet",
    "slug": "readlet",
    "version": "1.1.0",
    "platforms": [
      "ios",
      "android"
    ],
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "readlet",
    "userInterfaceStyle": "automatic",
    "assetBundlePatterns": [
      "**/*"
    ],
    "runtimeVersion": "1.1.0",
    "updates": {
      "url": "https://u.expo.dev/1ebfe8dc-deab-4c0d-9e11-383cf55ab246"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#FFFFFF"
      },
      "permissions": [
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT"
      ],
      "package": "com.psydo.readlet",
      "versionCode": 3
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash.png",
          "resizeMode": "contain",
          "backgroundColor": "#FFFFFF",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ],
      "expo-status-bar",
      "expo-secure-store",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Readlet nutzt Face ID, um die App-Sperre zu entsperren."
        }
      ],
      "expo-sqlite",
      "expo-localization",
      "expo-updates",
      "expo-asset"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "1ebfe8dc-deab-4c0d-9e11-383cf55ab246"
      }
    },
    "owner": "psydo"
  }
}
